<?xml version="1.0" encoding="utf-8"?>
<!--
    page_nav_camera.xml — Camera AI page (Page 1) di DirectionActivity ViewPager
    Glassmorphism: bg_beacon_panel untuk overlay kamera, glass badge untuk objek,
    glass bottom dock untuk action buttons. Semua ID dipertahankan persis.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1B2A">

    <!-- ============================================================
         LAYER 1: AR GL Surface & Camera Preview — full screen
         ============================================================ -->
    <android.opengl.GLSurfaceView
        android:id="@+id/arGlSurfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.camera.view.PreviewView
        android:id="@+id/camPreviewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Kamera AI aktif"
        android:visibility="gone"
        app:scaleType="fillCenter"
        app:implementationMode="compatible" />


    <!-- ============================================================
         LAYER 2: Detection Bounding Box Overlay
         ============================================================ -->
    <ImageView
        android:id="@+id/camDetectionOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:importantForAccessibility="no" />

    <!-- ============================================================
         LAYER 3: Top vignette gradient untuk safe zone header
         ============================================================ -->
    <View
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_gravity="top"
        android:background="@drawable/gradient_overlay_top"
        android:importantForAccessibility="no" />

    <!-- ============================================================
         LAYER 4: TOP GLASS PANEL — Lokasi + Tujuan + Toggle + Mulai
         ============================================================ -->
    <LinearLayout
        android:id="@+id/camNavOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_beacon_panel"
        android:padding="14dp"
        android:layout_gravity="top"
        android:layout_margin="12dp">

        <!-- Row: Swipe hint (kiri) + Lokasi (tengah) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Swipe back hint -->
            <TextView
                android:id="@+id/camSwipeHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◀"
                android:textSize="16sp"
                android:textColor="#66FFFFFF"
                android:paddingEnd="6dp"
                android:importantForAccessibility="no" />

            <!-- Pin icon -->
            <FrameLayout
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_status_active"
                android:importantForAccessibility="no">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_navigation"
                    app:tint="#FFFFFF"
                    android:importantForAccessibility="no"
                    android:contentDescription="" />
            </FrameLayout>

            <!-- Lokasi saat ini -->
            <TextView
                android:id="@+id/camTvCurrentRoom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Lokasi: Mencari AR..."
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:singleLine="true"
                android:ellipsize="end"
                android:importantForAccessibility="no" />

        </LinearLayout>

        <!-- Mode Selector: NAVIGASI vs PETA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#20FFFFFF"
            android:padding="3dp"
            android:layout_marginVertical="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/camBtnModeNav"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="NAVIGASI AR"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                app:backgroundTint="#CC1565C0"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/camBtnModeMap"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="BUAT PETA AR"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#BBFFFFFF"
                app:backgroundTint="#00000000"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <!-- ================= MAP MODE CONTROLS ================= -->
        <LinearLayout
            android:id="@+id/camLayoutMapControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jenis Penanda:"
                android:textSize="11sp"
                android:textColor="#CCFFFFFF"
                android:layout_marginTop="4dp" />

            <!-- Category Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginVertical="4dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chipTypeRoom"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Ruangan"
                        android:textSize="11sp"
                        android:textColor="#FFFFFF"
                        app:strokeColor="#80FFFFFF"
                        app:backgroundTint="#CC1565C0"
                        android:layout_marginEnd="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chipTypeDoor"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Pintu"
                        android:textSize="11sp"
                        android:textColor="#CCFFFFFF"
                        app:strokeColor="#40FFFFFF"
                        app:backgroundTint="#20FFFFFF"
                        android:layout_marginEnd="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chipTypeHallway"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Koridor"
                        android:textSize="11sp"
                        android:textColor="#CCFFFFFF"
                        app:strokeColor="#40FFFFFF"
                        app:backgroundTint="#20FFFFFF"
                        android:layout_marginEnd="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chipTypeOther"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Lainnya"
                        android:textSize="11sp"
                        android:textColor="#CCFFFFFF"
                        app:strokeColor="#40FFFFFF"
                        app:backgroundTint="#20FFFFFF" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Mark Spot Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/camBtnMarkSpot"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="TANDAI LOKASI"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                app:backgroundTint="#CC2E7D32"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_navigation"
                app:iconGravity="textStart" />

            <!-- Action buttons row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp"
                android:gravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/camBtnConnections"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="Koneksi"
                    android:textSize="11sp"
                    android:textColor="#81D4FA" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/camBtnSavedMarkers"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="Penanda"
                    android:textSize="11sp"
                    android:textColor="#81D4FA" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/camBtnScanAgain"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="Pindai Ulang"
                    android:textSize="11sp"
                    android:textColor="#81D4FA" />
            </LinearLayout>

        </LinearLayout>

        <!-- ================= NAVIGATE MODE CONTROLS ================= -->
        <LinearLayout
            android:id="@+id/camLayoutNavigateControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Destination Spinner row -->
            <LinearLayout
                android:id="@+id/camLlDestination"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_compass_arrow"
                    app:tint="#AAFFFFFF"
                    android:layout_marginEnd="6dp"
                    android:importantForAccessibility="no" />

                <Spinner
                    android:id="@+id/camSpinnerDestination"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_spinner_glass"
                    android:padding="6dp" />

            </LinearLayout>

            <!-- Maneuver Banner (Turn Cue & Distance) -->
            <LinearLayout
                android:id="@+id/camLayoutManeuverBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_glass_badge"
                android:padding="8dp"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/camTvManeuverTurn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⬆ LURUS"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#80DEEA"
                    android:paddingEnd="8dp" />

                <TextView
                    android:id="@+id/camTvManeuverHint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Pilih tujuan untuk memulai navigasi AR"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Start Navigation Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/camBtnStartNavigation"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="MULAI NAVIGASI"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:hapticFeedbackEnabled="true"
                android:contentDescription="Tekan untuk memulai navigasi ke tujuan yang dipilih"
                app:backgroundTint="#CC1565C0"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_navigation"
                app:iconGravity="textStart"
                app:iconSize="18dp"
                app:iconTint="@color/white"
                app:strokeColor="#55FFFFFF"
                app:strokeWidth="1dp"
                app:rippleColor="@color/ripple_color" />
        </LinearLayout>

        <!-- Navigation Info Panel (visible during navigation) -->
        <LinearLayout
            android:id="@+id/camNavInfoPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="6dp"
            android:visibility="gone">

            <!-- Step Progress -->
            <TextView
                android:id="@+id/camTvStepProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Langkah - dari -"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:importantForAccessibility="no" />

            <!-- Heading + Target -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="2dp"
                android:importantForAccessibility="no">

                <TextView
                    android:id="@+id/camTvHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0°"
                    android:textSize="13sp"
                    android:textColor="#CCFFFFFF"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/camTvTargetHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="13sp"
                    android:textColor="#CCFFFFFF"
                    android:layout_marginStart="12dp"
                    android:visibility="gone"
                    android:importantForAccessibility="no" />

            </LinearLayout>

            <!-- Status -->
            <TextView
                android:id="@+id/camTvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Menunggu..."
                android:textSize="12sp"
                android:textColor="#AAFFFFFF"
                android:gravity="center"
                android:importantForAccessibility="no" />

            <!-- Alignment Progress -->
            <ProgressBar
                android:id="@+id/camProgressAlignment"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/primary"
                android:progressBackgroundTint="#33FFFFFF"
                android:importantForAccessibility="no" />

            <!-- Step Counter -->
            <TextView
                android:id="@+id/camTvStepCounter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Langkah: 0 / 0"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:gravity="center"
                android:visibility="gone"
                android:importantForAccessibility="no" />

        </LinearLayout>

    </LinearLayout>

    <!-- ============================================================
         LAYER 4.5: Target Crosshair Overlay (visible in Map mode)
         ============================================================ -->
    <FrameLayout
        android:id="@+id/camCrosshairOverlay"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:visibility="gone"
        android:importantForAccessibility="no">
        <View
            android:id="@+id/camCrosshairRing"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_status_active" />
        <View
            android:id="@+id/camCrosshairDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="center"
            android:background="#00E676" />
    </FrameLayout>

    <!-- ============================================================
         LAYER 5: Detected Object Name Badge — center of screen
         ============================================================ -->
    <TextView
        android:id="@+id/camTvObjectName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="32dp"
        android:background="@drawable/bg_glass_badge"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:paddingHorizontal="28dp"
        android:paddingVertical="14dp"
        android:text=""
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:importantForAccessibility="no"
        android:accessibilityLiveRegion="none" />

    <!-- ============================================================
         LAYER 6: Jelaskan button — di atas bottom dock
         ============================================================ -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="170dp"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Loading ProgressBar -->
        <ProgressBar
            android:id="@+id/camProgressDescribe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="#FFFFFF"
            android:visibility="gone"
            android:layout_marginBottom="8dp"
            android:importantForAccessibility="no" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/camBtnDescribe"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:text="Jelaskan"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:hapticFeedbackEnabled="true"
            android:contentDescription="Jelaskan apa yang terlihat di kamera"
            app:backgroundTint="#CC1565C0"
            app:cornerRadius="26dp"
            app:icon="@drawable/ic_camera_voice"
            app:iconGravity="textStart"
            app:iconSize="20dp"
            app:iconTint="@color/white"
            app:strokeColor="#55FFFFFF"
            app:strokeWidth="1dp"
            app:rippleColor="@color/ripple_color" />

    </LinearLayout>

    <!-- ============================================================
         LAYER 7: BOTTOM GLASS DOCK — Action buttons (Lanjut / Hentikan)
         ============================================================ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:background="@drawable/bg_glass_bottom_panel">

        <!-- Confirm Step / Count Step Button (large, accessible) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/camBtnAction"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:text="LANJUT&#10;Langkah Berikutnya"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:enabled="false"
            android:visibility="gone"
            android:gravity="center"
            android:hapticFeedbackEnabled="true"
            android:contentDescription="Tekan untuk lanjut ke langkah berikutnya"
            app:backgroundTint="#CC1565C0"
            app:cornerRadius="16dp"
            app:strokeColor="#55FFFFFF"
            app:strokeWidth="1dp"
            app:rippleColor="@color/ripple_color" />

        <!-- Stop Navigation Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/camBtnStop"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="HENTIKAN NAVIGASI"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:visibility="gone"
            android:hapticFeedbackEnabled="true"
            android:contentDescription="Tekan untuk menghentikan navigasi"
            app:backgroundTint="#99B71C1C"
            app:cornerRadius="12dp"
            app:strokeColor="#50FFFFFF"
            app:strokeWidth="1dp" />

    </LinearLayout>

</FrameLayout>
