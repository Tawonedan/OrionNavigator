<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117"
    tools:context=".ui.AddFaceActivity">

    <!-- CAMERA PREVIEW (Fullscreen in scanner mode) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:scaleType="fillCenter"
        app:implementationMode="compatible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Overlay Vignette when scanner is active -->
    <View
        android:id="@+id/viewVignette"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#66000000"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Back Button (Top Left) -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="44dp"
        android:background="@drawable/bg_glass_fab"
        android:contentDescription="Kembali"
        android:padding="10dp"
        android:src="@drawable/ic_arrow_back"
        app:tint="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Title / Mode Header (Top Center) -->
    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.12"
        android:text="DAFTARKAN WAJAH"
        android:textColor="#DDFFFFFF"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Flip Camera Button (Top Right, scanner mode) -->
    <ImageButton
        android:id="@+id/btnFlipCamera"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="44dp"
        android:background="@drawable/bg_glass_fab"
        android:contentDescription="Balik Kamera"
        android:padding="10dp"
        android:src="@drawable/ic_flip_camera"
        android:visibility="gone"
        app:tint="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ============================================================
         STATE 1: NAME INPUT VIEW
         ============================================================ -->
    <LinearLayout
        android:id="@+id/layoutNameInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Animated Face Icon Circle -->
        <FrameLayout
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@drawable/bg_status_active">
            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_person_add"
                app:tint="#FFFFFF"
                android:contentDescription="" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Pendaftaran Wajah Kamera"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Kamera AI akan mendeteksi wajah secara otomatis dengan panduan suara interaktif."
            android:textColor="#AAAAAA"
            android:textSize="13sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPersonName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:hint="Nama Lengkap / Panggilan"
            app:boxBackgroundColor="#1A2332"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusTopStart="16dp"
            app:boxStrokeColor="#1565C0"
            app:hintTextColor="#81D4FA"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPersonName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName|textCapWords"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Start Camera Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartCameraEnroll"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="Mulai Pindai dengan Kamera"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_camera"
            app:iconTint="@color/white"
            app:iconGravity="textStart"
            app:backgroundTint="#1565C0"
            app:cornerRadius="28dp" />

        <!-- Select from Gallery option -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickFromGallery"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="Atau Pilih Foto dari Galeri"
            android:textColor="#81D4FA"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

    </LinearLayout>

    <!-- ============================================================
         STATE 2: LIVE CAMERA SCANNER VIEW
         ============================================================ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutScannerControls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Instruction Banner Top -->
        <LinearLayout
            android:id="@+id/layoutInstructionBanner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="100dp"
            android:background="@drawable/bg_glass_badge"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvQualityProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kualitas: 0%"
                android:textColor="#00E676"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvScannerPrompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Posisikan wajah Anda di tengah lingkaran"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Center Viewfinder Target Ring -->
        <FrameLayout
            android:id="@+id/viewfinderRing"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:background="@drawable/bg_status_rings"
            app:layout_constraintBottom_toTopOf="@id/layoutScannerBottom"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutInstructionBanner">

            <ProgressBar
                android:id="@+id/scannerProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/bg_rssi_progress"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Bottom Controls for Scanner Mode -->
        <LinearLayout
            android:id="@+id/layoutScannerBottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- Manual Snap Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSnapNow"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Ambil Foto Sekarang"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:icon="@drawable/ic_camera"
                app:iconGravity="textStart"
                app:backgroundTint="#CC1565C0"
                app:cornerRadius="27dp" />

            <!-- Cancel Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelScanner"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:text="Batal"
                android:textColor="#CCFFFFFF"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ============================================================
         STATE 3: ENROLLMENT SUCCESS VIEW
         ============================================================ -->
    <LinearLayout
        android:id="@+id/layoutSuccess"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/bg_status_active">
            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check"
                app:tint="#00E676"
                android:contentDescription="" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvSuccessTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Wajah Berhasil Didaftarkan!"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSuccessSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Kamera AI sekarang dapat mengenali orang ini secara otomatis."
            android:textColor="#AAAAAA"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDone"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="32dp"
            android:text="Selesai"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#00C853"
            app:cornerRadius="27dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
